# =============================================================
# RoC Desk — Docker Deployment Environment Variables
# =============================================================
# Copy this file to .env and fill in the values for Docker deployment.
# cp docker.env.sample .env
# =============================================================

# --- Django Core ---
SECRET_KEY=change-me-to-a-very-random-and-long-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,host.docker.internal

# Comma-separated. Must be full https:// origins (scheme required by Django).
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Field-level Encryption (API keys, passwords, secrets stored in DB) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key makes all encrypted DB values permanently unrecoverable.
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet

# --- Cloud Storage (Optional for Media Files) ---
# Set ONE of these to True to enable cloud storage
USE_AZURE_STORAGE=False
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media-support-desk
# Optional: leave AZURE_ACCOUNT_KEY blank to authenticate with an Azure AD App
# Registration (needs the "Storage Blob Data Contributor" role on the account).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --- Nginx ---
# Space-separated list of domains/IPs this VPS serves (others get dropped with 444).
# This is the ONLY place domains are configured for nginx routing — nginx.conf.template
# has no hardcoded domain, so the same template runs unmodified on every VPS.
NGINX_SERVER_NAMES=your-domain.com www.your-domain.com

# Domain to load the Let's Encrypt cert for once certbot has been run (see nginx.conf.template).
NGINX_SSL_DOMAIN=your-domain.com

# --- Database ---
# Only need to define these if using the included Postgres container
DB_NAME=rocdesk_db
DB_USER=rocdesk_user
DB_PASSWORD=change-me-strong-db-password

# --- Channel Layer (WebSocket / Django Channels) ---
CHANNEL_LAYER_URL=redis://redis:6379/2

# --- Marketplace Licensing ---
# Base URL for the activation API. The product calls /v1/activate and /v1/validate.
LICENSE_MARKETPLACE_URL=https://marketplace.example.com
LICENSE_PRODUCT_ID=roc-support-desk
# Optional: must match ACTIVATION_API_SECRET if the marketplace enables it.
# Keep this in deployment secrets, never commit a production value.
LICENSE_ACTIVATION_API_SECRET=
# Base64 Ed25519 public key for signed Marketplace entitlements. Prefer
# embedding it in licensing/marketplace_key.py in production releases.
LICENSE_ENTITLEMENT_PUBLIC_KEY=
# Set automatically when a public key is configured; set explicitly during rollout.
LICENSE_REQUIRE_SIGNED_ENTITLEMENT=False

# --- Evolution API (WhatsApp) ---
# Master switch for the WhatsApp gateway; set False when no Evolution API is deployed.
WA_ENABLED=True
# When deployed with docker-compose, the web container can reach it using "http://evolution_api:8080"
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=your_global_api_key_here
EVOLUTION_INSTANCE_NAME=ROC_SUPPORT
EVOLUTION_WEBHOOK_TOKEN=my_secure_webhook_token_123

# --- Email Notifications (IMAP Polling) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=your_email@gmail.com
IMAP_APP_PASSWORD=your_app_password_here

# --- SMTP (Outbound Email) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=your_email@gmail.com
